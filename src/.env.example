# Limite de anexos por envio de mensagem (ver docs/dev/contracts/attachment.md
# > Limite e retenção, e docs/dev/architecture/06b-services.md > GuardService)
MAX_ATTACHMENTS_PER_MESSAGE=10

# Tamanho mínimo do texto para mensagens só-de-texto (sem anexo) — ver
# docs/dev/contracts/message.md e docs/dev/architecture/06b-services.md
# > GuardService
MIN_TEXT_LENGTH=2

# Intervalo do worker periódico que recomputa a disponibilidade de
# credenciais no cache (ver docs/dev/architecture/06b-services.md >
# ProviderCacheService e docs/dev/architecture/08-redis.md) — vale só
# pra credenciais de providers LOCAIS/self-hosted (providers.is_external
# = false). Uma recomputação fora de hora (disparada por uma tentativa
# de envio que encontrou indisponibilidade) reinicia essa contagem só
# pra aquela credencial — não soma dois ciclos próximos.
PROVIDER_CACHE_REFRESH_SECONDS=60

# Mesma coisa, mas pra credenciais de providers EXTERNOS
# (providers.is_external = true — serviços de nuvem como OpenAI/
# Anthropic). Intervalo bem mais espaçado de propósito: testar um
# serviço de nuvem com a mesma frequência de um servidor local custaria
# rate limit e possível chamada tarifada à toa — detecção rápida de
# queda em provider externo depende mais do caminho de
# ProviderCacheService.report_unavailable (disparado por uma tentativa
# de envio real) do que deste ciclo periódico.
PROVIDER_CACHE_REFRESH_SECONDS_EXTERNAL=3600

# Chave mestra (AES-256-GCM, 32 bytes em base64) usada por
# core/security.py > CredentialCipher para cifrar/decifrar credenciais
# de provider (ver docs/dev/research/cifragem de credenciais.md e
# docs/dev/architecture/06b-services.md > CredentialCipher). NUNCA
# versionar um valor real aqui — em produção, prefira um Docker secret
# (arquivo montado, somente leitura) a uma variável de ambiente. Gere
# com: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ANA_CREDENTIALS_MASTER_KEY=

# Rótulo da chave mestra vigente (permite rotação: linhas cifradas com
# uma chave antiga são recifradas sob demanda quando lidas, ver
# CredentialCipher acima).
ANA_CREDENTIALS_KEY_ID=master-2026-01
